# Eco — variáveis lidas exclusivamente por src/config.ts.
# Nenhum outro arquivo do módulo toca process.env (arquitetura.md §0.3).

# Liga/desliga o cache inteiro. Qualquer valor diferente de "false" mantém ligado.
CACHE_ENABLED=true

# Shadow mode: consulta o cache, compara com a resposta do pipeline, registra a
# divergência e NÃO serve. Obrigatório na primeira semana de qualquer estreia (§9).
CACHE_SHADOW_MODE=true

# Abaixo desta semelhança textual, o shadow mode conta divergência. NÃO é threshold de
# cache: nada é servido ou recusado por causa dele, e o evento carrega o número medido
# para você reanalisar com outro corte depois da semana de shadow.
CACHE_SHADOW_MISMATCH_FLOOR=0.9

# Chave da API de embedding (voyage-3-lite, 512d).
VOYAGE_API_KEY=
